{
  "crons": [
    {
      "path": "/api/gestion/admin?recurso=metricas-cron",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/gestion/pacientes?modo=recalcular-asistencia-cron",
      "schedule": "30 8 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/t/:codigo",
      "destination": "/api/reservar?codigo=:codigo"
    }
  ],
  "functions": {
    "api/gestion/admin.js": {
      "maxDuration": 300
    },
    "api/gestion/pacientes.js": {
      "maxDuration": 300,
      "includeFiles": "node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs"
    },
    "api/asistente.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/index_new.html",
      "destination": "https://odfrancovinzon.vonn.com.ar/",
      "permanent": true
    },
    {
      "source": "/((?!api/|gestion|admin|pacientes|turno|turnos|mobilephotouploader|t/|assets/).*)",
      "has": [
        {
          "type": "host",
          "value": "od-francovinzon.vercel.app"
        }
      ],
      "destination": "https://odfrancovinzon.vonn.com.ar/$1",
      "permanent": true
    }
  ]
}
